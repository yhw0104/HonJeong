# 백엔드 로컬 비밀값 예시 — 실제 값은 backend/.env에 채우고 git에는 올리지 마세요.
# 사용법: 이 파일을 backend/.env로 복사한 뒤 아래 "여기에_..." 자리를 실제 값으로 바꾸세요.

# 카카오 로그인 — 카카오가 준 ID 토큰이 "우리 앱 것인지" 확인하는 데 씁니다.
# 카카오 개발자 콘솔(https://developers.kakao.com) > 앱 설정 > 앱 키 > REST API 키
KAKAO_APP_KEY=여기에_카카오_REST_API_키

# 소셜 로그인 모드: mock(기본) | real
# real로 바꾸면 실제 카카오 검증을 씁니다. KAKAO_APP_KEY를 반드시 채운 뒤 바꾸세요.
OAUTH_MODE=mock

# --- 아래는 docker compose(배포·통합 실행)에서 쓰는 값 ---
# `docker compose up -d db`로 로컬 DB만 띄울 때도 DB_PASSWORD는 필요합니다.

# DB 비밀번호. 기본값을 두지 않으므로 반드시 설정해야 합니다.
# ★ 로컬 개발자는 honjeong 으로 두세요 — 기존 로컬 볼륨이 그 값으로 초기화돼 있어 다른 값을
#   넣으면 접속이 실패합니다(POSTGRES_PASSWORD는 볼륨 최초 생성 시에만 적용됩니다). 로컬이
#   아니면(서버 등) 새로 생성한 값을 쓰세요.
DB_PASSWORD=여기에_DB_비밀번호_로컬은_honjeong

# JWT 서명 시크릿(256bit 이상, HS256 서명 키입니다 — 유출되면 누구든 임의 사용자 행세를 하는
# 토큰을 위조할 수 있으니 실제 값을 커밋하면 안 됩니다). 아래 명령으로 새로 만들어 넣으세요.
#   openssl rand -base64 48
JWT_SECRET=여기에_JWT_시크릿

# 업로드 사진의 공개 URL 접두사. 로컬 전체 스택은 https://localhost/files,
# 서버는 https://<도메인>/files 입니다.
FILES_BASE_URL=https://localhost/files

# Caddy가 인증서를 발급할 도메인. 로컬은 비워두면 localhost(내부 인증서)로 뜹니다.
# DOMAIN=honjeong.example.com
